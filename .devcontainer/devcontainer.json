{
  "name": "ft_ping",
  "image": "mcr.microsoft.com/vscode/devcontainers/cpp:trixie",
  "remoteUser": "vscode",
  "runArgs": [
    "--cap-add=NET_RAW"
  ],
  "postCreateCommand": "sh .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "eamodio.gitlens"
      ]
    }
  }
}